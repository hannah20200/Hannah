# .env.local 로 복사해서 채워 넣으세요 (커밋 금지)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# 5단계: Instagram 게시 (선택)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Instagram 로그인 토큰이면 graph.instagram.com, Facebook 로그인 토큰이면 graph.facebook.com
INSTAGRAM_GRAPH_HOST=graph.instagram.com
INSTAGRAM_API_VERSION=v26.0
# Instagram 서버가 이미지를 가져갈 수 있는 이 앱의 공개 주소 (예: cloudflared 터널)
PUBLIC_BASE_URL=
# 예약 게시 스케줄러 끄기: SCHEDULER=off
